# Frontend environment variables for the Crossword Challenge Platform (React)
# IMPORTANT: Do not commit real secrets. Copy this file to `.env` and fill values as appropriate.

# Base URL for the Django backend REST API (e.g., http://localhost:8000/api)
REACT_APP_API_BASE=http://localhost:8000/api

# Optional: default page size for leaderboard fetches
REACT_APP_LEADERBOARD_PAGE_SIZE=20
