# PUBLIC: Example environment variables for the React frontend
# Copy to .env and fill in with your environment-specific values.

# PUBLIC_INTERFACE
# Base URL for the Django backend API (e.g., http://localhost:8000/api)
REACT_APP_API_BASE_URL=http://localhost:8000/api

# PUBLIC_INTERFACE
# Site URL used for email redirect during Supabase auth or similar flows
# For non-Supabase auth, still used to build absolute links where needed.
REACT_APP_SITE_URL=http://localhost:3000
