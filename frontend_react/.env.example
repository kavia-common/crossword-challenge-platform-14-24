# React frontend environment configuration
# IMPORTANT: Include the /api base path and a trailing slash to avoid 404s due to double/missing slashes.
# For local Django: http://localhost:8000/api/
# For containerized env, use the backend service URL exposed by the environment.

REACT_APP_API_BASE=http://localhost:8000/api/
# Optional: Leaderboard page size
REACT_APP_LEADERBOARD_PAGE_SIZE=20
